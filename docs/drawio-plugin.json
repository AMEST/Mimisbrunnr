{
  "Id": "7f6c0b2e-6a5d-4d9f-9c2b-1e8f0a3d5b71",
  "PluginIdentifier": "mm.plugin.drawio",
  "Name": "Draw.io diagrams",
  "Version": "0.1.0",
  "PageTemplates": [],
  "Macros": [
    {
      "MacroIdentifier": "mm.plugin.drawio.diagram",
      "Name": "Draw.io diagram",
      "Description": "Editable draw.io diagram stored as page attachments: <name>.drawio.xml (source) and <name>.drawio.png (preview). Set the identifier in macro settings.",
      "Icon": "data:image/svg+xml;base64,",
      "Params": [
        "name",
        "width",
        "height"
      ],
      "DefaultValues": {
        "name": "diagram",
        "width": "100%",
        "height": "400px"
      },
      "CustomParamsEditor": "<div style=\"font-size:13px;color:#6c757d;margin-top:8px;line-height:1.5\">\n  Identifier is stored in the macro tag. Use latin letters, digits, <code>_</code> or <code>-</code> (up to 64 chars).<br>\n  Width and height are maximum limits (e.g. <code>100%</code>, <code>400px</code>); click the preview to open the full image with zoom.<br>\n  To edit the diagram, close this dialog and use <strong>Edit diagram</strong> in the Preview modal opened from the editor or in the page view.<br>\n  On save, two page attachments are created/updated: <code>&lt;name&gt;.drawio.xml</code> (source) and <code>&lt;name&gt;.drawio.png</code> (preview with embedded source).<br>\n  Two macros with the same identifier share one diagram.\n</div>",
      "Template": "<style>\n  div[id='macro_{{MacroIdOnPage}}']{display:block!important;width:100%;}\n  .mm-drawio{font-family:inherit;color:inherit;}\n  .mm-drawio-box{border:1px solid #dee2e6;border-radius:6px;overflow:hidden;margin:8px 0;}\n  .mm-drawio-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 10px;background:#f8f9fa;border-bottom:1px solid #dee2e6;}\n  .mm-drawio-title{font-weight:600;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}\n  .mm-drawio-btn{border:1px solid #ced4da;background:#fff;border-radius:4px;padding:3px 10px;cursor:pointer;font-size:13px;}\n  .mm-drawio-btn:hover{background:#e9ecef;}\n  .mm-drawio-stage{position:relative;min-height:120px;display:flex;align-items:center;justify-content:center;background:#fff;}\n  .mm-drawio-preview{display:block;max-width:100%;height:auto;cursor:zoom-in;}\n  .mm-drawio-preview[hidden],.mm-drawio-empty[hidden],.mm-drawio-edit[hidden]{display:none;}\n  .mm-drawio-empty{padding:24px;color:#6c757d;font-size:14px;text-align:center;}\n  .mm-drawio-status{padding:4px 10px;font-size:12px;color:#6c757d;min-height:22px;}\n  .mm-drawio-overlay{position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.45);display:flex;flex-direction:column;}\n  .mm-drawio-overlay[hidden]{display:none;}\n  .mm-drawio-overlay-head{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#343a40;color:#fff;font-size:14px;}\n  .mm-drawio-frame{flex:1;width:100%;border:0;background:#fff;}\n</style>\n<div class=\"mm-drawio\" data-name=\"{{name}}\" data-page=\"{{PageId}}\" data-space=\"{{SpaceKey}}\" data-width=\"{{width}}\" data-height=\"{{height}}\">\n  <div class=\"mm-drawio-box\">\n    <div class=\"mm-drawio-toolbar\">\n      <span class=\"mm-drawio-title\">Diagram: {{name}}</span>\n      <button class=\"mm-drawio-btn mm-drawio-edit\" type=\"button\" hidden>Edit diagram</button>\n    </div>\n    <div class=\"mm-drawio-stage\">\n      <img class=\"mm-drawio-preview\" alt=\"Diagram\" hidden>\n      <div class=\"mm-drawio-empty\">Loading diagram...</div>\n    </div>\n    <div class=\"mm-drawio-status\"></div>\n  </div>\n  <div class=\"mm-drawio-overlay\" hidden>\n    <div class=\"mm-drawio-overlay-head\"><span>Diagram editor</span><button class=\"mm-drawio-btn mm-drawio-close\" type=\"button\">Close</button></div>\n    <iframe class=\"mm-drawio-frame\" title=\"draw.io editor\" src=\"about:blank\"></iframe>\n  </div>\n</div>\n<script>\n(function () {\n  var EDITOR_URL = 'https://embed.diagrams.net/';\n  var root = document.querySelector('div[id=\"macro_{{MacroIdOnPage}}\"] .mm-drawio');\n  if (!root) return;\n\n  var name = (root.getAttribute('data-name') || '').trim();\n  var pageId = root.getAttribute('data-page') || '';\n  var spaceKey = root.getAttribute('data-space') || '';\n  var maxWidth = (root.getAttribute('data-width') || '').trim();\n  var maxHeight = (root.getAttribute('data-height') || '').trim();\n  var statusEl = root.querySelector('.mm-drawio-status');\n  var preview = root.querySelector('.mm-drawio-preview');\n  var emptyEl = root.querySelector('.mm-drawio-empty');\n  var editBtn = root.querySelector('.mm-drawio-edit');\n  var overlay = root.querySelector('.mm-drawio-overlay');\n  var frame = root.querySelector('.mm-drawio-frame');\n\n  function cssSize(value, fallback) {\n    return /^(\\d{1,4}(px|em|rem|vh|vw|%)?|auto)$/.test(value) ? value : fallback;\n  }\n  preview.style.maxWidth = cssSize(maxWidth, '100%');\n  preview.style.maxHeight = cssSize(maxHeight, '400px');\n\n  function setStatus(text) { statusEl.textContent = text || ''; }\n\n  if (!/^[A-Za-z0-9_-]{1,64}$/.test(name)) {\n    emptyEl.textContent = 'Set a diagram name in macro settings (latin letters, digits, _ and -).';\n    return;\n  }\n\n  var xmlName = name + '.drawio.xml';\n  var pngName = name + '.drawio.png';\n  var base = '/api/attachment/' + encodeURIComponent(pageId) + '/';\n  var xmlUrl = base + encodeURIComponent(xmlName);\n  var pngUrl = base + encodeURIComponent(pngName);\n\n  function refreshPreview() {\n    preview.onload = function () { emptyEl.hidden = true; preview.hidden = false; };\n    preview.onerror = function () {\n      preview.hidden = true;\n      emptyEl.hidden = false;\n      emptyEl.textContent = 'Diagram not created yet. Press \"Edit diagram\" to draw it.';\n    };\n    preview.src = pngUrl + '?t=' + Date.now();\n  }\n  refreshPreview();\n\n  fetch('/api/space/' + encodeURIComponent(spaceKey) + '/permission', {credentials: 'same-origin'})\n    .then(function (r) { return r.ok ? r.json() : null; })\n    .then(function (p) { if (p && p.canEdit) editBtn.hidden = false; })\n    .catch(function () {});\n\n  var editorOrigin = null;\n  var saving = false;\n  var exitRequested = false;\n  var pendingXml = '';\n  var exportTimer = null;\n  var listener = null;\n\n  function post(msg) {\n    if (!frame.contentWindow || !editorOrigin) return;\n    frame.contentWindow.postMessage(JSON.stringify(msg), editorOrigin);\n  }\n\n  function finish(message) {\n    if (exportTimer) { clearTimeout(exportTimer); exportTimer = null; }\n    setStatus(message || '');\n    saving = false;\n    pendingXml = '';\n    if (exitRequested) closeEditor();\n  }\n\n  function closeEditor() {\n    overlay.hidden = true;\n    frame.src = 'about:blank';\n    if (listener) { window.removeEventListener('message', listener); listener = null; }\n    editorOrigin = null;\n    exitRequested = false;\n    refreshPreview();\n  }\n\n  function toBlob(uri) {\n    var comma = uri.indexOf(',');\n    var meta = uri.slice(0, comma);\n    var data = uri.slice(comma + 1);\n    if (meta.indexOf('base64') >= 0) {\n      var bin = atob(data);\n      var bytes = new Uint8Array(bin.length);\n      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n      return new Blob([bytes], {type: 'image/png'});\n    }\n    return new Blob([decodeURIComponent(data)], {type: 'image/png'});\n  }\n\n  function upload(fileName, blob) {\n    var form = new FormData();\n    form.append('file', blob, fileName);\n    return fetch('/api/attachment/' + encodeURIComponent(pageId), {\n      method: 'POST', body: form, credentials: 'same-origin'\n    }).then(function (r) {\n      if (!r.ok) throw new Error('upload failed: ' + r.status);\n    });\n  }\n\n  function handleMessage(event) {\n    if (!editorOrigin || event.origin !== editorOrigin || event.source !== frame.contentWindow) return;\n    var msg;\n    try { msg = JSON.parse(event.data); } catch (e) { return; }\n\n    if (msg.event === 'init') {\n      fetch(xmlUrl, {credentials: 'same-origin'})\n        .then(function (r) { return r.ok ? r.text() : ''; })\n        .then(function (xml) {\n          post({action: 'load', xml: xml || '', autosave: 0, saveAndExit: 1, title: name});\n        })\n        .catch(function () {\n          post({action: 'load', xml: '', autosave: 0, saveAndExit: 1, title: name});\n        });\n      return;\n    }\n\n    if (msg.event === 'save') {\n      if (saving) return;\n      saving = true;\n      exitRequested = !!msg.exit;\n      pendingXml = msg.xml || '';\n      setStatus('Saving...');\n      var xmlBlob = new Blob([pendingXml], {type: 'application/xml'});\n      upload(xmlName, xmlBlob)\n        .then(function () {\n          setStatus('Rendering preview...');\n          post({action: 'export', format: 'xmlpng', scale: 1, border: 8, background: '#ffffff'});\n          exportTimer = setTimeout(function () {\n            if (saving) finish('PNG export timed out, XML saved at ' + new Date().toLocaleTimeString());\n          }, 20000);\n        })\n        .catch(function (e) { finish('Save failed: ' + e.message); });\n      return;\n    }\n\n    if (msg.event === 'export' && msg.format === 'xmlpng') {\n      if (!saving || !msg.data) return;\n      upload(pngName, toBlob(msg.data))\n        .then(function () { finish('Saved at ' + new Date().toLocaleTimeString()); })\n        .catch(function (e) { finish('Save failed: ' + e.message); });\n      return;\n    }\n\n    if (msg.event === 'exit') {\n      if (saving) { exitRequested = true; return; }\n      closeEditor();\n    }\n  }\n\n  editBtn.addEventListener('click', function () {\n    overlay.hidden = false;\n    editorOrigin = new URL(EDITOR_URL).origin;\n    listener = handleMessage;\n    window.addEventListener('message', listener);\n    frame.src = EDITOR_URL + '?embed=1&proto=json&spin=1&libraries=1&saveAndExit=1';\n    setStatus('');\n  });\n\n  root.querySelector('.mm-drawio-close').addEventListener('click', closeEditor);\n})();\n</script>",
      "RenderUrl": "",
      "SendUserToken": false,
      "StoreParamsInDatabase": false
    }
  ]
}
